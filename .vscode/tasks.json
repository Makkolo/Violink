    { "label": "make windows", "type": "shell", "command": "make windows", "problemMatcher": ["$go"] },
    { "label": "make run", "type": "shell", "command": "make run", "problemMatcher": ["$go"] },
    { "label": "make release", "type": "shell", "command": "make release", "problemMatcher": ["$go"] }
  ]
}
