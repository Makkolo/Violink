{
  "tray": true,
  "webui": {
    "enabled": true,
    "listen": "127.0.0.1:8470"
  },
  "log": {
    "folder": "logs",
    "level": "info",
    "maxSizeKB": 1024,
    "maxFiles": 5,
    "console": true
  },
  "persist": {
    "file": "data/persist.json",
    "saveIntervalSec": 60,
    "maxSeriesMinutes": 180,
    "maxSeriesSamples": 100000
  },
  "scripts": {
    "folder": "scripts",
    "timeoutMs": 1000,
    "queueLength": 64
  },
  "simulations": {
    "folder": "simulations"
  },
  "inputs": [
    {
      "name": "someTcpClientInput",
      "type": "tcp-client",
      "enabled": false,
      "note": "Some info",
      "address": "192.168.1.123:4041",
      "framing": { "start": "StartOfMessage", "end": "\r\n", "maxLength": 100, "keepMarkers": true, "idleResetMs": 2000},
      "idleTimeoutSec": 30
    },
    {
      "name": "someComInput",
      "type": "com",
      "enabled": false,
      "port": "COM123",
      "baud": 9600,
      "dataBits": 8,
      "parity": "none",
      "stopBits": 1
    },
    {
      "name": "someUdpInput",
      "type": "udp",
      "enabled": false,
      "address": "127.0.0.1:12345",
      "remote": "192.168.1.231:12345"
    }
  ],
  "outputs": [
    {
      "name": "someTcpServerOutput",
      "type": "tcp-server",
      "enabled": false,
      "note": "Some comment",
      "address": ":4100",
      "lineEnd": "\r\n",
      "resendLastOnConnect": true
    },
    {
      "name": "someComOutput",
      "type": "com",
      "enabled": false,
      "port": "COM321",
      "baud": 9600,
      "lineEnd": "\r\n"
    },
    {
      "name": "someUdpOutput",
      "type": "udp",
      "enabled": false,
      "address": "127.0.0.1:8008",
      "lineEnd": "\r\n"
    }
  ]
}
