{
  "tray": true,
  "webui": {
    "enabled": true,
    "listen": "127.0.0.1:8470"
  },
  "log": {
    "folder": "logs",
    "level": "info",
    "maxSizeKB": 1024,
    "maxFiles": 5,
    "console": true
  },
  "persist": {
    "file": "data/persist.json",
    "saveIntervalSec": 60,
    "maxSeriesMinutes": 180,
    "maxSeriesSamples": 100000
  },
  "scripts": {
    "folder": "scripts",
    "timeoutMs": 1000,
    "queueLength": 64
  },
  "simulations": {
    "folder": "simulations"
  },
  "inputs": [
    {
      "name": "wind",
      "type": "tcp-client",
      "enabled": false,
      "note": "Anemometer on a serial server, NMEA MWV sentences",
      "address": "192.168.1.50:4001",
      "framing": { "start": "$", "end": "\r\n", "maxLength": 200, "keepMarkers": true, "idleResetMs": 2000 },
      "idleTimeoutSec": 30
    },
    {
      "name": "baro",
      "type": "com",
      "enabled": false,
      "note": "Barometer, sends 'P= 1013.25 hPa' once a second",
      "port": "COM3",
      "baud": 9600,
      "dataBits": 8,
      "parity": "none",
      "stopBits": "1",
      "framing": { "start": "", "end": "\r\n", "maxLength": 100 }
    },
    {
      "name": "adam",
      "type": "com",
      "enabled": false,
      "note": "ADAM-4017 analog input module at address 01 on RS-485, answers end with CR only",
      "port": "COM4",
      "baud": 9600,
      "framing": { "start": ">", "end": "\r", "maxLength": 100, "keepMarkers": false },
      "poll": [ { "command": "#01\r", "intervalMs": 1000 } ]
    },
    {
      "name": "gps",
      "type": "udp",
      "enabled": true,
      "note": "NMEA over UDP, port 10110 is the usual NMEA port",
      "address": ":10110",
      "framing": { "start": "", "end": "\r\n", "maxLength": 200 }
    }
  ],
  "outputs": [
    {
      "name": "main",
      "type": "tcp-server",
      "enabled": true,
      "note": "The end program connects here",
      "address": ":4100",
      "lineEnd": "\r\n",
      "resendLastOnConnect": true
    },
    {
      "name": "display",
      "type": "com",
      "enabled": false,
      "note": "A serial display",
      "port": "COM5",
      "baud": 9600,
      "lineEnd": "\r\n"
    },
    {
      "name": "udp-out",
      "type": "udp",
      "enabled": false,
      "address": "127.0.0.1:10111",
      "lineEnd": "\r\n"
    }
  ]
}
